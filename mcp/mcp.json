{
    "servers": {
          "microsoft.docs.mcp": {
            "type": "http",
            "url": "https://learn.microsoft.com/api/mcp"
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ],
            "type": "stdio",
            "env": {}
        },
        "github": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/"
        },
        "giphy": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-server-giphy"
            ],
            "env": {
                "GIPHY_API_KEY": "${input:giphy_api_key}"
            }
        },
        "ado": {
            "type": "stdio",
            "command": "mcp-server-azuredevops",
            "args": ["${input:ado_org}"]
        },
        "brightdata": {
            "type": "http",
            "url": "https://mcp.brightdata.com/mcp?token=${input:brightdata_api_token}",
            "headers": {
                "Authorization": "Bearer ${input:brightdata_api_token}"
            }
        }
    },
    "inputs": [
        {
            "id": "giphy_api_key",
            "type": "promptString",
            "description": "Giphy API Key",
            "password": true
        },
        {
            "id": "ado_org",
            "type": "promptString",
            "description": "Azure DevOps organization name  (e.g. 'contoso')"
        },
        {
            "id": "brightdata_api_token",
            "type": "promptString",
            "description": "Bright Data API Token",
            "password": true
        }
    ]
}